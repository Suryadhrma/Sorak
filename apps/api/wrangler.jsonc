{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sorak",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // Selain rute ini, aset statis disajikan tanpa menjalankan Worker (tidak menghitung kuota request).
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom", "script_name": "sorak-realtime" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sorak-db",
      "database_id": "ef980faf-9e95-4bfc-b03e-a5d04cdfa83e",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "consumers": [{ "queue": "sorak-game-events" }]
  }
}
