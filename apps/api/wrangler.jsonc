{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sorak",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // Lokal ditimpa .dev.vars. GOOGLE_CLIENT_SECRET dan JWT_SECRET lewat wrangler secret put.
  "vars": {
    "APP_ORIGIN": "https://sorak.helpu.workers.dev",
    // Client ID memang publik: ikut di URL login Google.
    "GOOGLE_CLIENT_ID": "1094752542047-easm89psmopsfrbqe2fv515eogg1udno.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // Selain rute ini, aset statis disajikan tanpa menjalankan Worker (tidak menghitung kuota request).
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom", "script_name": "sorak-realtime" }]
  },
  // Per IP (ADR 0005). Harus sama dengan PIN_LOOKUP_LIMIT dan WS_CONNECT_LIMIT di @sorak/shared (dicek test).
  // PIN_LOOKUP untuk cek PIN; WS_CONNECT untuk WebSocket pemain, lebih longgar karena reconnect massal.
  "ratelimits": [
    { "name": "PIN_LOOKUP", "namespace_id": "2604", "simple": { "limit": 120, "period": 60 } },
    { "name": "WS_CONNECT", "namespace_id": "2605", "simple": { "limit": 600, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sorak-db",
      "database_id": "ef980faf-9e95-4bfc-b03e-a5d04cdfa83e",
      "migrations_dir": "migrations"
    }
  ],
  // Satu event per pemanggilan: satu event terbesar sudah sekitar 27 query, dan D1 Free membatasi 50 per pemanggilan.
  // retry_delay sama dengan GAME_EVENT_CONSUMER_RETRY_DELAY_SEC (dicek test). Setelah max_retries, pesan pindah ke DLQ.
  "queues": {
    "consumers": [
      {
        "queue": "sorak-game-events",
        "max_batch_size": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "sorak-game-events-dlq"
      }
    ]
  },
  // Hapus hasil game lebih dari 30 hari, setiap hari 02.17 WIB (19.17 UTC), saat kelas tidak berjalan.
  "triggers": { "crons": ["17 19 * * *"] },
  // Workers Logs: CPU time per request tercatat di invocation log. Free plan: 200.000 log event per hari.
  "observability": { "enabled": true }
}
